{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "sweetpad-lldb",
            "request": "launch",
            "name": "Build and Launch (SweetPad)",
            "preLaunchTask": "sweetpad: launch",
            "stopAll": true
        },
        {
            "type": "sweetpad-lldb",
            "request": "attach",
            "name": "Attach to Running App (SweetPad)",
            "description": "Use this if the app is already running to avoid rebuild"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:Tarot}",
            "name": "Debug TarotApp",
            "target": "TarotApp",
            "configuration": "debug",
            "preLaunchTask": "swift: Build Debug TarotApp"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:Tarot}",
            "name": "Release TarotApp",
            "target": "TarotApp",
            "configuration": "release",
            "preLaunchTask": "swift: Build Release TarotApp"
        }
    ]
}